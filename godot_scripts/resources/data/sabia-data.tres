[resource]
script = ExtResource("1_sgb3p")
scientific_name = "Turdus Rufiventris"
popular_names = Array[String](["Sabiá-Laranjeira", "Sabiá-Cavalo"])
conservation_status = "Baixo risco"
diet = "Insetos, minhocas e frutas maduras, incluindo frutas cultivadas como mamão.
"
habitats = "É comum em bordas de florestas, parques, quintais e áreas urbanas arborizadas. 
"
curiosity = "Foi imortalizado na “Canção do Exílio”, de Gonçalves Dias, juntou-se oficialmente aos outros quatro símbolos nacionais – a bandeira, o hino, o brasão de armas e o selo, passando a ter a mesma importância deles na representação do Brasil em 3 de outubro de 2002, por decreto do presidente Fernando Henrique Cardoso."
region_northeast = true
region_central_west = true
region_southeast = true
region_south = true
